# Public site URL (used for canonical URLs, sitemap, hreflang, JSON-LD, OG images)
NEXT_PUBLIC_SITE_URL=https://arganride.com

# Contact details shown on the site and in structured data
NEXT_PUBLIC_PHONE="+212 600 000 000"
NEXT_PUBLIC_WHATSAPP=212600000000
NEXT_PUBLIC_EMAIL=booking@arganride.com

# --- Booking delivery (enable any combination) ---
# Email via Resend (https://resend.com): dispatcher gets the booking, client is CC'd
RESEND_API_KEY=
BOOKING_EMAIL_TO=
BOOKING_EMAIL_FROM="Argan Ride <bookings@arganride.com>"

# Telegram message to the drivers' group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Any webhook (Zapier / Make / n8n / Google Apps Script) receives {ref, text}
BOOKING_WEBHOOK_URL=

# --- Optional live flight lookup (AeroDataBox on RapidAPI) ---
AERODATABOX_API_KEY=
